PORT=3000
# Docker (db:up) usa 5433; una instalación local directa de PostgreSQL suele usar 5432.
DATABASE_URL=postgresql://reservet:reservet_local@localhost:5433/reservet
# Horas de vida de la sesión (1-720). Por defecto 8.
SESSION_TTL_HOURS=8
# Usuario de prueba LOCAL para `npm run db:seed` (cámbialo; mínimo 8 caracteres).
SEED_USERNAME=demo
SEED_PASSWORD=demo-local-password
# Base EXCLUSIVA de pruebas (su nombre debe terminar en _test; las pruebas la vacían).
TEST_DATABASE_URL=postgresql://reservet_candidate:local_candidate_password@localhost:5432/reservet_candidate_test
